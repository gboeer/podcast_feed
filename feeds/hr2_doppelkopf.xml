2ce52/c0300c57-d153-4d67-9a00-a7b8cbab485e_106033018_1781880487439.mp3" length="49602476" type="audio/mp3" /><media:content url="https://hr-progressive.ard-mcdn.de/odinson/hr2-doppelkopf/c0300c57-d153-4d67-9a00-a7b8cbab485e/3b09863d-a7f9-4108-8915-e36bbf92ce52/c0300c57-d153-4d67-9a00-a7b8cbab485e_106033018_1781880487439.mp3" medium="audio" duration="3101" type="audio/mp3" /><pubDate>Mon, 22 Jun 2026 12:04:00 +0200</pubDate><itunes:duration>3101</itunes:duration><itunes:image href="https://api.ardmediathek.de/image-service/images/urn:ard:image:01432be4e7e03a65?w=448&amp;ch=808471ea6118b262" /></item><item><title>"Man muss Zugehörigkeit in Deutschland leider immer verhandeln" | Musa Deli, Sozialpsychologe</title><description>Vier von zehn Menschen in Deutschland haben eine Migrationsgeschichte. Eine Geschichte, die fast immer verbunden ist mit der Frage: "Gehöre ich hier wirklich dazu?" </description><guid>https://www.ardsounds.de/episode/urn:ard:episode:95daad6a9635a35b/</guid><link>https://www.ardsounds.de/episode/urn:ard:episode:95daad6a9635a35b/</link><enclosure url="https://hr-progressive.ard-mcdn.de/odinson/hr2-doppelkopf/b0d62ea0-83bc-4078-8fb6-90f82ac04b3a/4f21c967-c891-4221-808b-38550ee2574a/b0d62ea0-83bc-4078-8fb6-90f82ac04b3a_106027682_1781515076816.mp3" length="48231596" type="audio/mp3" /><media:content url="https://hr-progressive.ard-mcdn.de/odinson/hr2-doppelkopf/b0d62ea0-83bc-4078-8fb6-90f82ac04b3a/4f21c967-c891-4221-808b-38550ee2574a/b0d62ea0-83bc-4078-8fb6-90f82ac04b3a_106027682_1781515076816.mp3" medium="audio" duration="3015" type="audio/mp3" /><pubDate>Tue, 16 Jun 2026 12:05:00 +0200</pubDate><itunes:duration>3015</itunes:duration><itunes:image href="https://api.ardmediathek.de/image-service/images/urn:ard:image:3b7a71a769c77fd8?w=448&amp;ch=5979508bea43e995" /></item><item><title>"Den Wirtschaftswissenschaften fehlt ein Gerechtigkeitsbegriff" | Daniel Stähr, Ökonom</title><description>Sie sitzen im Zentrum der Macht, beraten Regierungen und Unternehmen, lenken die Geschicke von Staaten und Institutionen: die Ökonomen. Einer von ihnen ist Daniel Stähr, Jahrgang 1990.</description><guid>https://www.ardsounds.de/episode/urn:ard:episode:aa5b6233e9d14898/</guid><link>https://www.ardsounds.de/episode/urn:ard:episode:aa5b6233e9d14898/</link><enclosure url="https://hr-progressive.ard-mcdn.de/odinson/hr2-doppelkopf/9d258aaf-b811-4f5d-af07-c32456808e73/478a30f9-3369-421b-b962-46dff083baa4/9d258aaf-b811-4f5d-af07-c32456808e73_105967828_1780908603586.mp3" length="48654380" type="audio/mp3" /><media:content url="https://hr-progressive.ard-mcdn.de/odinson/hr2-doppelkopf/9d258aaf-b811-4f5d-af07-c32456808e73/478a30f9-3369-421b-b962-46dff083baa4/9d258aaf-b811-4f5d-af07-c32456808e73_105967828_1780908603586.mp3" medium="audio" duration="3041" type="audio/mp3" /><pubDate>Thu, 11 Jun 2026 12:04:00 +0200</pubDate><itunes:duration>3041</itunes:duration><itunes:image href="https://api.ardmediathek.de/image-service/images/urn:ard:image:ea166b375d2c816f?w=448&amp;ch=84b8c43350ad62bc" /></item><item><title>"Frauen schlafen anders als Männer" | Suzann Kirschner-Brouns, Ärztin</title><description>"Frauen schlafen anders als Männer" | Suzann Kirschner-Brouns, Ärztin
